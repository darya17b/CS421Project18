VITE_API_URL=/api
VITE_USE_MOCK=false

# Okta frontend configuration
VITE_OKTA_ISSUER=https://login.wsu.edu/oauth2/default
VITE_OKTA_CLIENT_ID=0oa19yes4cwMmJvwk2p8
# Keep redirect URI on same origin as the running frontend app.
# If omitted, frontend falls back to <window.origin><VITE_OKTA_CALLBACK_PATH>.
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback
VITE_OKTA_CALLBACK_PATH=/login/callback
VITE_OKTA_SCOPES=openid profile email
VITE_OKTA_ADMIN_GROUPS=BAM.PROD.ESFCOM.ADMIN
