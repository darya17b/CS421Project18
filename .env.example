# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# Signs and verifies login tokens. Required; docker compose fails without it.
# Generate one with:  openssl rand -hex 32
# (no openssl? PowerShell:  -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }) )
JWT_SECRET=

# Optional overrides (defaults are in docker-compose.yml)
# MONGO_USER=admin
# MONGO_PASSWORD=secret
# MONGO_DB=vccwebsite
# PORT=8080
# ALLOWED_ORIGINS=*
# Base URL for emailed set-password links. Must be https in any real deployment.
# APP_URL=http://localhost:8080
